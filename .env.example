# Copy to .env. Never commit .env or paste these values into chat.
# The robotics team key also goes in team.key (chmod 600), which curl reads.
# Do not send that key to signed upload URLs or the inference API.

PERCEPTRON_API_KEY=
ROBOTICS_BASE_URL=https://robotics.perceptron.inc
ROBOTICS_TEAM_KEY=
DEPLOYMENT_ID=
ARM_PORT=
PUBLIC_URL=

# OpenCV indexes from `lerobot-find-cameras opencv`. Check after every replug.
# Side = the Logitech C920, fixed. Wrist = the arm camera, which films the clip.
SIDE_CAM_INDEX=0
WRIST_CAM_INDEX=1

# 1 = MockArm + MockCamera + ml.mock_perception. Set to 0 when the real handoff lands.
USE_MOCKS=1
