# Copy to .env. Never commit .env or paste these values into chat.
# The robotics team key also goes in team.key (chmod 600), which curl reads.
# Do not send that key to signed upload URLs or the inference API.

PERCEPTRON_API_KEY=
ROBOTICS_BASE_URL=https://robotics.perceptron.inc
ROBOTICS_TEAM_KEY=
DEPLOYMENT_ID=
ARM_PORT=
PUBLIC_URL=

# 1 = MockArm + ml.mock_perception. Set to 0 when the real handoff lands.
USE_MOCKS=1
