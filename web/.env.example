# `npm run dev` reads web/.env.development and talks to the orchestrator on port 8000.
# `npm run build` does not load that file, so the built app uses its own host
# (FastAPI, including the tunnel). Do not put these in a file named .env:
# Vite loads .env for the production build and would bake localhost into the phone.

# Optional override for frontend-only work against `npm run mock`:
# VITE_WS_URL=ws://localhost:8787
# VITE_API_URL=http://localhost:8000

# GitHub Pages sets these in .github/workflows/pages.yml, not in a local .env.
# VITE_BASE=/dubhacks_2026/
# VITE_PAGES=1
